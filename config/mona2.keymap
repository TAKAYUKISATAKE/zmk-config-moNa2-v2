#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
/* DYA Studio から作成したマクロを呼び出す `&rmacro <slot>` を定義する。
   slot は 0 〜 CONFIG_ZMK_RUNTIME_MACRO_COUNT-1 (現状 0〜7)。
   どのマクロがどのスロットに入っているかは DYA Studio のマクロ一覧で確認する。
   キーへの割り当ては DYA Studio のキーマップエディタからも行える。 */
#include <behaviors/runtime_macro.dtsi>
/* デフォルトレイヤー変更 behavior `&df`。
   DYA Studio の「OSごとのデフォルトレイヤー」から設定できるほか、
   キーマップエディタで `&df DF_SEL <layer>` / `&df DF_INC` を
   任意のキーに割り当てられる。 */
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100


/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};


&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /* Old update's ten combos, available for editing in DYA Studio.
       Keep the previous DYA slots for Tab/Copy/Paste/Cut. Slots 10–15 are free. */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        select_all {
            slot = <0>;
            display-name = "Select All (A+S)";
            key-positions = <10 11>;
            bindings = <&host_key LC(A) LG(A)>;
            layers = <0 6>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        tab {
            slot = <1>;
            display-name = "Tab (W+E)";
            key-positions = <1 2>;
            bindings = <&kp TAB>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        copy {
            slot = <2>;
            display-name = "Copy (S+D)";
            key-positions = <11 12>;
            bindings = <&host_key LC(C) LG(C)>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        paste {
            slot = <3>;
            display-name = "Paste (D+F)";
            key-positions = <12 13>;
            bindings = <&host_key LC(V) LG(V)>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        cut {
            slot = <4>;
            display-name = "Cut (F+G)";
            key-positions = <13 14>;
            bindings = <&host_key LC(X) LG(X)>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        shift_tab {
            slot = <5>;
            display-name = "Shift+Tab (E+R)";
            key-positions = <2 3>;
            bindings = <&kp LS(TAB)>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        function {
            slot = <6>;
            display-name = "Function / Right Shift (J+K)";
            key-positions = <17 18>;
            bindings = <&lt 1 RIGHT_SHIFT>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        undo {
            slot = <7>;
            display-name = "Undo (Z+X)";
            key-positions = <21 22>;
            bindings = <&host_key LC(Z) LG(Z)>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        redo {
            slot = <8>;
            display-name = "Redo (X+C)";
            key-positions = <22 23>;
            bindings = <&host_key LC(Y) LG(LS(Z))>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };

        clipboard {
            slot = <9>;
            display-name = "Clipboard (C+V)";
            key-positions = <23 24>;
            bindings = <&kp LG(V)>;
            timeout-ms = <50>;
            require-prior-idle-ms = <0>;
        };
    };

    /* 静的マクロ。キーマップ上で &BT0 / &screenshot などの名前で直接
       参照しているため、そのまま残している (DYA Studio 上では編集不可)。
       DYA Studio から編集したいマクロは Web UI で新規作成し、
       キーに `&rmacro <slot>` を割り当てて使う。 */
    macros {
        ime_eisu: ime_eisu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&host_key INT_MUHENKAN LANG2>;
        };

        ime_kana: ime_kana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&host_key INT_HENKAN LANG1>;
        };

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        number00: number00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
            label = "NUMBER00";
        };

        sleep_macro: sleep_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LG(X)>,
                <&macro_wait_time 20>,
                <&kp U>,
                <&macro_wait_time 20>,
                <&kp S>;

            label = "SLEEP_MACRO";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on 0>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off 0 &tog_off 1>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on 1>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };
    };

    behaviors {
        host_key: host_key {
            compatible = "mona,behavior-host-key";
            #binding-cells = <2>;
            display-name = "Host Key (Windows / Apple)";
        };

        nav_eisu: nav_eisu {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "NAV / Eisu";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&ime_eisu>;
        };

        nav_kana: nav_kana {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "NAV / Kana";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&ime_kana>;
        };

        /* Preserve the old LEFT_ALT hold and select the IME key only on tap. */
        henkan_alt: henkan_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Alt / Henkan or Kana";
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            bindings = <&kp>, <&ime_kana>;
        };

        hold_bt_clear: hold_bt_clear {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Hold to Clear Bluetooth";
            tapping-term-ms = <1200>;
            flavor = "tap-preferred";
            bindings = <&bt>, <&none>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // 旧 update の回転順 (cw=SCRL_UP, ccw=SCRL_DOWN)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // kp C_VOL_UP/DN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_UP>;
            ccw-binding = <&msc SCRL_DOWN>;
        };

        rsr_horizontal: rsr_horizontal {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            cw-binding = <&msc SCRL_LEFT>;
            ccw-binding = <&msc SCRL_RIGHT>;
        };

        rsr_volume: rsr_volume {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp Q             &kp W         &kp E         &kp R                    &kp T                                                 &kp Y      &kp U  &kp I      &kp O    &kp P
&mt LCTRL A       &kp S         &kp D         &kp F                    &kp G                              &kp SEMI           &kp H      &kp J  &kp K      &lt 5 L  &lt 6 MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                    &kp B        &lt 4 LEFT_BRACKET    &kp RIGHT_BRACKET  &kp N      &kp M  &kp COMMA  &kp DOT  &lt 3 SLASH
&host_key LCTRL LGUI  &kp LEFT_ALT  &host_key LGUI LCTRL  &henkan_alt LEFT_ALT 0  &lt 2 SPACE  &host_key LS(CAPS) LANG2          &kp BACKSPACE      &kp ENTER                             &mt RCTRL ESCAPE
            >;

            sensor-bindings = <&rsr_default>, <&rsr_volume>;
        };

        layer_1 {
            display-name = "FUNCTION";
            bindings = <
&trans             &trans         &host_key LG(LC(LEFT_ARROW)) LG(LS(TAB))  &host_key LG(LC(RIGHT_ARROW)) LG(TAB)  &host_key LG(TAB) LC(UP_ARROW)                                         &trans  &trans  &trans  &trans  &trans
&kp LG(LC(T))      &kp LS(LC(A))  &kp LA(LG(SPACE))       &kp LA(SPACE)            &kp LC(LS(K))                               &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans         &trans                  &trans                   &trans                 &sleep_macro         &trans  &trans  &trans  &trans  &trans  &trans
&kp LS(LC(LG(Y)))  &trans         &trans                  &trans                   &kp LS(LA(LC(LG(A))))  &kp LS(LC(LG(P)))    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_2 {
            display-name = "NUM";
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                     &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK               &kp UNDERSCORE    &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL    &kp SINGLE_QUOTE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &trans           &trans        &trans       &trans            &trans                                                                     &kp PIPE
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_3 {
            display-name = "F-KEYS";
            bindings = <
&trans  &kp F7   &kp F8   &kp F9   &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &kp F4   &kp F5   &kp F6   &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F1   &kp F2   &kp F3   &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp F10  &kp F11  &kp F12  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_4 {
            display-name = "BLE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &hold_bt_clear BT_CLR_CMD 0
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &hold_bt_clear BT_CLR_ALL_CMD 0
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_5 {
            display-name = "SCROLL";
            bindings = <
&trans     &trans  &trans  &trans  &trans                    &trans  &host_key LA(LS(TAB)) LG(LS(TAB))  &host_key LA(TAB) LG(TAB)  &trans  &trans
&kp LS(A)  &trans  &trans  &trans  &trans            &trans  &trans  &kp LC(LS(TAB))  &kp LC(TAB)  &trans  &trans
&kp LS(Z)  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans           &trans       &trans  &trans
&trans     &trans  &trans  &trans  &trans  &trans    &trans  &trans                                        &trans
            >;

            sensor-bindings = <&rsr_horizontal>;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&kp ASTERISK          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp MINUS                    &kp DEL   &kp LEFT  &kp UP_ARROW  &kp RIGHT  &trans
&mt LCTRL TAB         &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp PLUS             &trans  &kp TAB   &mkp MB1  &mkp MB3      &mkp MB2   &trans
&mt LEFT_SHIFT SLASH  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp EQUAL  &trans    &trans  &mkp MB5  &mkp MB4  &kp DOWN      &trans     &trans
&kp COLON             &kp KP_NUMBER_0  &number00        &kp PERIOD       &trans     &trans    &trans  &trans                                       &trans
            >;

            sensor-bindings = <&rsr_horizontal>;
        };
    };
};
